# ============================================================
# WiFi Fault Diagnosis — Environment Variable Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# -----------------------------------------------
# General
# -----------------------------------------------
DEBUG=false
PROJECT_NAME="WiFi Fault Diagnosis API"
VERSION=0.1.0
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# -----------------------------------------------
# Database
# -----------------------------------------------
# Development (SQLite)
DATABASE_URL=sqlite:///./wifi_fault.db

# Production (PostgreSQL example)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/wifi_fault

# -----------------------------------------------
# Machine Learning
# -----------------------------------------------
MODEL_PATH=models/random_forest.pkl

# -----------------------------------------------
# Digital Twin — Ubuntu VM SSH
# -----------------------------------------------
DT_VM1_HOST=192.168.56.101
DT_VM1_PORT=22
DT_VM2_HOST=192.168.56.102
DT_VM2_PORT=22
DT_SSH_USER=ubuntu
DT_SSH_KEY_PATH=~/.ssh/id_rsa

# -----------------------------------------------
# RAG / LLM
# -----------------------------------------------
LLM_PROVIDER=openai          # openai | ollama | huggingface
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=                 # your OpenAI key or leave blank for Ollama
EMBEDDING_MODEL=text-embedding-ada-002
VECTORSTORE_PATH=rag/vectorstore

# -----------------------------------------------
# ESP32 / Telemetry
# -----------------------------------------------
USE_SIMULATED_TELEMETRY=true
TELEMETRY_SIMULATION_INTERVAL_S=5
